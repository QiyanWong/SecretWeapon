<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <configSections>
        <section name="WcR2.Network" type="WzComparerR2.Network.NetworkConfig, WzComparerR2.Network, Version=2.2.0.0, Culture=neutral, PublicKeyToken=null" allowLocation="true" allowDefinition="Everywhere" allowExeDefinition="MachineToApplication" overrideModeDefault="Allow" restartOnExternalChanges="true" requirePermission="true" />
