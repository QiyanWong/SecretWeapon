    <WcR2>
        <mainStyle value="Office2007VistaGlass" />
        <mainStyleColor value="DimGray" />
        <sortWzOnOpened value="true" />
        <autoDetectExtFiles value="true" />
        <EnableAutoUpdate value="true" />
        <recentDocuments>
