        <section name="WcR2" type="WzComparerR2.Config.WcR2Config, WzComparerR2, Version=2.2.0.0, Culture=neutral, PublicKeyToken=null" allowLocation="true" allowDefinition="Everywhere" allowExeDefinition="MachineToApplication" overrideModeDefault="Allow" restartOnExternalChanges="true" requirePermission="true" />
        <section name="WcR2.CharaSim" type="WzComparerR2.Config.CharaSimConfig, WzComparerR2, Version=2.2.0.0, Culture=neutral, PublicKeyToken=null" allowLocation="true" allowDefinition="Everywhere" allowExeDefinition="MachineToApplication" overrideModeDefault="Allow" restartOnExternalChanges="true" requirePermission="true" />
        <section name="WcR2.CustomCSS" type="WzComparerR2.Config.CustomCSSConfig, WzComparerR2, Version=2.2.0.0, Culture=neutral, PublicKeyToken=null" allowLocation="true" allowDefinition="Everywhere" allowExeDefinition="MachineToApplication" overrideModeDefault="Allow" restartOnExternalChanges="true" requirePermission="true" />
        <section name="WcR2.ImageHandler" type="WzComparerR2.Config.ImageHandlerConfig, WzComparerR2, Version=2.2.0.0, Culture=neutral, PublicKeyToken=null" allowLocation="true" allowDefinition="Everywhere" allowExeDefinition="MachineToApplication" overrideModeDefault="Allow" restartOnExternalChanges="true" requirePermission="true" />
    </configSections>
    <WcR2.Network>
        <logLevel value="Info" />
        <nickName value="No Name #9103" />
        <wcID value="07abe463-df3f-445e-beda-ecd64e9782c6" />
        <servers value=":2100;:2101;:2102;:2103;:2104" />
    </WcR2.Network>
    <WcR2.MapRender>
        <volume value="1" />
        <muteOnLeaveFocus value="true" />
        <clipMapRegion value="true" />
        <defaultFontIndex value="0" />
        <useD2DRenderer value="false" />
        <topBar.Visible value="false" />
        <minimap.CameraRegionVisible value="false" />
